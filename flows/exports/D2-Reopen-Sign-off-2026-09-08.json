      "Compose_notes": {
        "runAfter": {
          "Get_item": [
            "Succeeded"
          ]
        },
        "type": "Compose",
        "inputs": "@concat(if(empty(coalesce(body('Get_item')?['SignOffNotes'], '')), '', concat(body('Get_item')?['SignOffNotes'], '  |  ')), 'REOPENED ', convertTimeZone(utcNow(), 'UTC', 'Central Standard Time', 'yyyy-MM-dd HH:mm'), ' by ', triggerBody()?['text'], if(equals(coalesce(body('Get_item')?['InstallerSignOff'], false), true), concat(' (was signed by ', coalesce(body('Get_item')?['InstallerSignOffBy']?['DisplayName'], 'unknown'), ')'), ''), if(empty(trim(coalesce(triggerBody()?['text_1'], ''))), '', concat(': ', trim(triggerBody()?['text_1']))))"
      },
      "Reopen": {
        "runAfter": {
          "Compose_notes": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "parameters/method": "POST",
            "parameters/uri": "_api/web/lists/GetByTitle('Assignments')/items(@{triggerBody()?['number']})",
            "parameters/headers": {
              "X-HTTP-Method": "MERGE",
              "If-Match": "*",
              "Content-Type": "application/json;odata=verbose",
              "Accept": "application/json;odata=verbose"
            },
            "parameters/body": "@{string(setProperty(json('{\"__metadata\":{\"type\":\"SP.Data.AssignmentsListItem\"},\"InstallerSignOff\":false,\"InstallerSignOffOn\":null,\"InstallerSignOffById\":null}'), 'SignOffNotes', outputs('Compose_notes')))}"
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "operationId": "HttpRequest",
            "connectionName": "shared_sharepointonline"
          }
        }
      },
