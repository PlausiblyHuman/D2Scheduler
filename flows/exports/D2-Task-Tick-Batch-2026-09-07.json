{
 "displayName": "D2 - Task Tick Batch",
 "flowId": "e8843056-53aa-f111-aaab-6045bd0196b3",
 "workflowEntityId": "e8843056-53aa-f111-aaab-6045bd0196b3",
 "state": "Started",
 "exportedUtc": "2026-09-07",
 "definition": {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "undefined",
  "parameters": {
   "$authentication": {
    "defaultValue": {},
    "type": "SecureObject"
   },
   "$connections": {
    "defaultValue": {},
    "type": "Object"
   }
  },
  "triggers": {
   "manual": {
    "type": "Request",
    "kind": "PowerAppV2",
    "inputs": {
     "schema": {
      "type": "object",
      "properties": {
       "number": {
        "description": "Assignment list item id",
        "title": "AssignmentID",
        "type": "number",
        "x-ms-content-hint": "NUMBER",
        "x-ms-dynamically-added": true
       },
       "text": {
        "description": "Comma separated taskId:flag pairs, flag 1 = complete, 0 = not",
        "title": "TaskUpdates",
        "type": "string",
        "x-ms-content-hint": "TEXT",
        "x-ms-dynamically-added": true
       },
       "number_1": {
        "description": "Please enter a number",
        "title": "TasksTotal",
        "type": "number",
        "x-ms-content-hint": "NUMBER",
        "x-ms-dynamically-added": true
       },
       "number_2": {
        "description": "Please enter a number",
        "title": "TasksComplete",
        "type": "number",
        "x-ms-content-hint": "NUMBER",
        "x-ms-dynamically-added": true
       },
       "text_1": {
        "description": "UPN of the person ticking",
        "title": "SignedByEmail",
        "type": "string",
        "x-ms-content-hint": "TEXT",
        "x-ms-dynamically-added": true
       }
      },
      "required": [
       "number",
       "text",
       "number_1",
       "number_2",
       "text_1"
      ]
     }
    }
   }
  },
  "actions": {
   "Ensure_user": {
    "runAfter": {},
    "type": "OpenApiConnection",
    "inputs": {
     "parameters": {
      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
      "parameters/method": "POST",
      "parameters/uri": "_api/web/ensureuser",
      "parameters/headers": {
       "Content-Type": "application/json;odata=verbose",
       "Accept": "application/json;odata=verbose"
      },
      "parameters/body": "{\"logonName\":\"i:0#.f|membership|@{triggerBody()?['text_1']}\"}"
     },
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "operationId": "HttpRequest",
      "connectionName": "shared_sharepointonline"
     }
    }
   },
   "Has_updates": {
    "actions": {
     "Apply_to_each_update": {
      "foreach": "@split(triggerBody()?['text'], ',')",
      "actions": {
       "Update_task": {
        "runAfter": {},
        "type": "OpenApiConnection",
        "inputs": {
         "parameters": {
          "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/lists/GetByTitle('Tasks')/items(@{first(split(item(), ':'))})",
          "parameters/headers": {
           "X-HTTP-Method": "MERGE",
           "If-Match": "*",
           "Content-Type": "application/json;odata=verbose",
           "Accept": "application/json;odata=verbose"
          },
          "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.TasksListItem\"},\"Complete\":@{if(equals(last(split(item(), ':')), '1'), 'true', 'false')},\"CompletedOn\":@{if(equals(last(split(item(), ':')), '1'), concat('\"', utcNow(), '\"'), 'null')},\"CompletedById\":@{if(equals(last(split(item(), ':')), '1'), string(body('Ensure_user')?['d']?['Id']), 'null')}}"
         },
         "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "operationId": "HttpRequest",
          "connectionName": "shared_sharepointonline"
         }
        }
       }
      },
      "runAfter": {},
      "type": "Foreach"
     }
    },
    "runAfter": {
     "Ensure_user": [
      "Succeeded"
     ]
    },
    "else": {
     "actions": {}
    },
    "expression": {
     "not": {
      "equals": [
       "@trim(triggerBody()?['text'])",
       ""
      ]
     }
    },
    "type": "If"
   },
   "Update_counters": {
    "runAfter": {
     "Has_updates": [
      "Succeeded"
     ]
    },
    "type": "OpenApiConnection",
    "inputs": {
     "parameters": {
      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
      "parameters/method": "POST",
      "parameters/uri": "_api/web/lists/GetByTitle('Assignments')/items(@{triggerBody()?['number']})",
      "parameters/headers": {
       "X-HTTP-Method": "MERGE",
       "If-Match": "*",
       "Content-Type": "application/json;odata=verbose",
       "Accept": "application/json;odata=verbose"
      },
      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.AssignmentsListItem\"},\"TasksTotal\":@{triggerBody()?['number_1']},\"TasksComplete\":@{triggerBody()?['number_2']}}"
     },
     "host": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "operationId": "HttpRequest",
      "connectionName": "shared_sharepointonline"
     }
    }
   },
   "Respond_to_a_Power_App_or_flow": {
    "runAfter": {
     "Update_counters": [
      "Succeeded"
     ]
    },
    "type": "Response",
    "kind": "PowerApp",
    "inputs": {
     "schema": {
      "type": "object",
      "properties": {
       "status": {
        "title": "Status",
        "type": "string",
        "x-ms-content-hint": "TEXT",
        "x-ms-dynamically-added": true
       }
      },
      "additionalProperties": {}
     },
     "statusCode": 200,
     "body": {
      "status": "Success"
     }
    }
   }
  }
 },
 "connectionReferences": {
