    "actions": {
      "Initialize_variable": {
        "runAfter": {},
        "metadata": {
          "operationMetadataId": "ab60e43b-1ec1-46b9-a801-713c923d1061"
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "today",
              "type": "string",
              "value": "@{formatDateTime(convertFromUtc(utcNow(),'Central Standard Time'),'yyyy-MM-dd')}"
            }
          ]
        }
      },
      "Initialize_variable_2": {
        "runAfter": {
          "Initialize_variable": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "b16b5326-3aa6-47cb-8154-51c91999756a"
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "yesterday",
              "type": "string",
              "value": "@{formatDateTime(addDays(convertFromUtc(utcNow(),'Central Standard Time'),-1),'yyyy-MM-dd')}"
            }
          ]
        }
      },
      "Get_items": {
        "runAfter": {
          "Compose_active_job_clause": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "9f615177-0f5d-436f-aace-cc2a38d13c62"
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35",
            "$filter": "ScheduledStart le '@{variables('today')}' and ScheduledFinish ge '@{variables('today')}' and NotApplicable ne 1 and @{outputs('Compose_active_job_clause')}",
            "$top": 500
          }
        }
      },
      "Get_items_2": {
        "runAfter": {
          "Get_items": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "f8f32bc8-8a82-48ae-8699-5b85352cb4f2"
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35",
            "$filter": "ScheduledFinish eq '@{variables('yesterday')}' and InstallerSignOff ne 1 and NotApplicable ne 1 and @{outputs('Compose_active_job_clause')}",
            "$top": 500
          }
        }
      },
      "Get_items_3": {
        "runAfter": {
          "Get_items_2": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "8ded9f7b-5366-48c1-adae-7623121d14aa"
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "45e9ff1f-bf36-4ab5-929d-25ab9a80d460",
            "$filter": "Active eq 1 and Unlimited ne 1",
            "$top": 100
          }
        }
      },
      "Get_items_4": {
        "runAfter": {
          "Get_items_3": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "2c904360-ba7a-446e-a71b-b73a7347ecae"
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "d36758cf-9d27-4342-84e4-817f8dcfa2ba",
            "$filter": "Date eq '@{variables('today')}'",
            "$top": 10
          }
        }
      },
      "Compose_2": {
        "runAfter": {
          "Get_items_4": [
            "Succeeded"
          ]
        },
        "metadata": {
          "operationMetadataId": "66e540c2-7b4e-48f2-b4a5-561b38bd1a50"
        },
        "type": "Compose",
        "inputs": "@length(outputs('Get_items_4')?['body/value'])"
      },
      "Condition_2": {
        "actions": {
          "Terminate": {
            "runAfter": {},
            "metadata": {
              "operationMetadataId": "e8b84bf4-4d4b-415d-97dd-7e52a557ab35"
            },
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            }
          }
        },
        "runAfter": {
          "Compose_2": [
            "Succeeded"
          ]
        },
        "else": {
          "actions": {
            "Apply_to_each": {
              "foreach": "@outputs('Get_items_3')?['body/value']",
              "actions": {
                "Filter_array": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "8f63c53d-a5d6-49e6-9f6b-a7b86459e980"
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Get_items')?['body/value']",
                    "where": "@equals(item()?['Crew']?['Value'], items('Apply_to_each')?['CrewID'])"
                  }
                },
                "Filter_array_2": {
                  "runAfter": {
                    "Filter_array": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "7ddcb2a7-cd9e-43d0-ae2d-1357a8ccec04"
                  },
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Get_items_2')?['body/value']",
                    "where": "@equals(item()?['Crew']?['Value'], items('Apply_to_each')?['CrewID'])"
                  }
                },
                "Compose": {
                  "runAfter": {
                    "Filter_array_2": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "61f59d0c-c833-4191-9427-4dad34cdf520"
                  },
                  "type": "Compose",
                  "inputs": "<div style=\"font-family:Segoe UI,sans-serif;font-size:14px;color:#1a2332\"><h2 style=\"color:#082544\">TODAY \u2014 @{formatDateTime(variables('today'),'ddd MM/dd')} \u00b7 @{items('Apply_to_each')?['Title']}</h2>@{if(empty(body('Filter_array')),'<p><em>No sub-phase scheduled today.</em></p>',concat('<p><strong>',first(body('Filter_array'))?['Job']?['Value'],'</strong><br>',first(body('Filter_array'))?['SubPhaseNumber'],' ',first(body('Filter_array'))?['SubPhaseName'],'</p><p><a href=\"https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler/Lists/Assignments/DispForm.aspx?ID=',string(first(body('Filter_array'))?['ID']),'\" style=\"color:#0b594b;text-decoration:underline\">Open sub-phase to sign off</a></p>'))}@{if(empty(body('Filter_array_2')),'',concat('<h3 style=\"color:#a84a18\">OUTSTANDING FROM YESTERDAY</h3><p>',string(length(body('Filter_array_2'))),' sub-phase(s) finished yesterday but not yet signed off.</p>'))}</div>"
                },
                "Send_an_email_(V2)": {
                  "runAfter": {
                    "Compose": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "5504e828-535c-4747-8602-0c7f8042a448"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{if(empty(coalesce(items('Apply_to_each')?['LeadEmail'], '')), 'stratirus@d2pools.com', items('Apply_to_each')?['LeadEmail'])}",
                      "emailMessage/Subject": "@{if(empty(coalesce(items('Apply_to_each')?['LeadEmail'], '')), '[no lead email] ', '')}D2 Dispatch \u2014 @{formatDateTime(variables('today'),'ddd MM/dd')} \u00b7 @{items('Apply_to_each')?['Title']}",
                      "emailMessage/Body": "@{outputs('Compose')}",
                      "emailMessage/Importance": "Normal"
                    }
                  }
                }
              },
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "fbd75ce0-5711-4cc9-a485-06d7001f4b9b"
              },
              "type": "Foreach"
            }
          }
        },
        "expression": {
          "greater": [
            "@outputs('Compose_2')",
            0
          ]
        },
        "metadata": {
          "operationMetadataId": "60c5436e-92d4-4228-9b1a-52e7538d7f30"
        },
        "type": "If"
      },
      "Get_active_jobs": {
        "runAfter": {
          "Initialize_variable_2": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "ee0ecabf-2f11-458d-a9ea-641f76d10cc3",
            "$filter": "Status eq 'Active'",
            "$top": 500
          }
        }
      },
      "Select_active_job_ids": {
        "runAfter": {
          "Get_active_jobs": [
            "Succeeded"
          ]
        },
        "type": "Select",
        "inputs": {
          "from": "@outputs('Get_active_jobs')?['body/value']",
          "select": "@concat('JobId eq ', string(item()?['ID']))"
        }
      },
      "Compose_active_job_clause": {
        "runAfter": {
          "Select_active_job_ids": [
            "Succeeded"
          ]
        },
        "type": "Compose",
        "inputs": "@if(empty(body('Select_active_job_ids')), 'JobId eq -1', concat('(', join(body('Select_active_job_ids'), ' or '), ')'))"
      }
    }
  }
