{
  "displayName": "D2 - Event-Driven Reconciliation",
  "flowId": "523d99c0-bc2e-7819-5d96-6faab60734f1",
  "workflowEntityId": "2764968c-4aa6-f111-b8dd-6045bd0196b3",
  "state": "Stopped",
  "exportedUtc": "2026-09-05T18:11:58.578985+00:00Z",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      },
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      }
    },
    "triggers": {
      "When_an_item_is_created_or_modified": {
        "recurrence": {
          "frequency": "Minute",
          "interval": 1
        },
        "splitOn": "@triggerOutputs()?['body/value']",
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetOnUpdatedItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35"
          }
        },
        "conditions": [
          {
            "expression": "@or(not(equals(triggerOutputs()?['body/Crew'], triggerOutputs()?['body/Crew@odata.oldValue'])), not(equals(triggerOutputs()?['body/ScheduledStart'], triggerOutputs()?['body/ScheduledStart@odata.oldValue'])), not(equals(triggerOutputs()?['body/DurationDays'], triggerOutputs()?['body/DurationDays@odata.oldValue'])), equals(triggerOutputs()?['body/Crew@odata.oldValue'], null))"
          }
        ]
      }
    },
    "actions": {
      "Initialize_touchedId": {
        "runAfter": {},
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "touchedId",
              "type": "integer",
              "value": "@triggerOutputs()?['body/ID']"
            }
          ]
        }
      },
      "Initialize_touchedCrew": {
        "runAfter": {
          "Initialize_touchedId": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "touchedCrew",
              "type": "string",
              "value": "@{coalesce(triggerOutputs()?['body/Crew'], '')}"
            }
          ]
        }
      },
      "Initialize_startDate": {
        "runAfter": {
          "Initialize_touchedCrew": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "startDate",
              "type": "string",
              "value": "@{formatDateTime(triggerOutputs()?['body/ScheduledStart'], 'yyyy-MM-dd')}"
            }
          ]
        }
      },
      "Initialize_duration": {
        "runAfter": {
          "Initialize_startDate": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "duration",
              "type": "integer",
              "value": "@int(coalesce(triggerOutputs()?['body/DurationDays'], 1))"
            }
          ]
        }
      },
      "Initialize_endDate": {
        "runAfter": {
          "Initialize_duration": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "endDate",
              "type": "string",
              "value": "@{formatDateTime(addDays(variables('startDate'), sub(variables('duration'), 1)), 'yyyy-MM-dd')}"
            }
          ]
        }
      },
      "Get_touched_assignment": {
        "runAfter": {
          "Initialize_endDate": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItem",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35",
            "id": "@variables('touchedId')"
          }
        }
      },
      "Get_crew": {
        "runAfter": {
          "Get_touched_assignment": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "45e9ff1f-bf36-4ab5-929d-25ab9a80d460",
            "$filter": "CrewID eq '@{variables('touchedCrew')}'",
            "$top": 1
          }
        }
      },
      "Condition_unlimited": {
        "actions": {
          "Terminate_unlimited_crew": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            }
          }
        },
        "runAfter": {
          "Get_crew": [
            "Succeeded"
          ]
        },
        "else": {
          "actions": {}
        },
        "expression": {
          "and": [
            {
              "equals": [
                "@length(outputs('Get_crew')?['body/value'])",
                1
              ]
            },
            {
              "equals": [
                "@coalesce(first(outputs('Get_crew')?['body/value'])?['Unlimited'], false)",
                true
              ]
            }
          ]
        },
        "type": "If"
      },
      "Get_overlapping": {
        "runAfter": {
          "Condition_unlimited": [
            "Succeeded"
          ]
        },
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
            "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35",
            "$filter": "Crew eq '@{variables('touchedCrew')}' and ScheduledStart le '@{variables('endDate')}' and ScheduledFinish ge '@{variables('startDate')}' and Id ne @{variables('touchedId')} and NotApplicable ne 1",
            "$top": 20
          }
        }
      },
      "Compose_conflict_count": {
        "runAfter": {
          "Get_overlapping": [
            "Succeeded"
          ]
        },
        "type": "Compose",
        "inputs": "@length(outputs('Get_overlapping')?['body/value'])"
      },
      "Condition_conflict": {
        "actions": {
          "Get_job": {
            "runAfter": {},
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                "table": "ee0ecabf-2f11-458d-a9ea-641f76d10cc3",
                "id": "@coalesce(outputs('Get_touched_assignment')?['body/Job']?['Id'], outputs('Get_touched_assignment')?['body/JobId'], outputs('Get_touched_assignment')?['body/JobLookupId'])"
              }
            }
          },
          "Compose_alert_body": {
            "runAfter": {
              "Get_job": [
                "Succeeded"
              ]
            },
            "type": "Compose",
            "inputs": "<div style=\"font-family:Segoe UI,sans-serif;font-size:14px;color:#1a2332\"><h2 style=\"color:#a84a18\">⚠ Double-book detected on @{variables('touchedCrew')}</h2><p><strong>Touched sub-phase:</strong> @{outputs('Get_touched_assignment')?['body/Job']?['Value']} → @{outputs('Get_touched_assignment')?['body/SubPhaseNumber']} @{outputs('Get_touched_assignment')?['body/SubPhaseName']}<br><strong>Dates:</strong> @{variables('startDate')} through @{variables('endDate')}</p><p><strong>Overlaps with (@{outputs('Compose_conflict_count')} total):</strong> @{first(outputs('Get_overlapping')?['body/value'])?['Job']?['Value']} → @{first(outputs('Get_overlapping')?['body/value'])?['SubPhaseNumber']} @{first(outputs('Get_overlapping')?['body/value'])?['SubPhaseName']} (@{formatDateTime(first(outputs('Get_overlapping')?['body/value'])?['ScheduledStart'], 'MM/dd')}–@{formatDateTime(first(outputs('Get_overlapping')?['body/value'])?['ScheduledFinish'], 'MM/dd')})</p><p><a href=\"https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler/Lists/Assignments/DispForm.aspx?ID=@{variables('touchedId')}\">Open the touched sub-phase</a></p></div>"
          },
          "Send_email_alert": {
            "runAfter": {
              "Compose_alert_body": [
                "Succeeded"
              ]
            },
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage/To": "@{coalesce(outputs('Get_job')?['body/ProjectManager']?['Email'], 'stratirus@d2pools.com')}",
                "emailMessage/Subject": "D2 ⚠ Double-book on @{variables('touchedCrew')} — @{outputs('Get_touched_assignment')?['body/Job']?['Value']}",
                "emailMessage/Body": "@{outputs('Compose_alert_body')}",
                "emailMessage/Importance": "High"
              }
            }
          }
        },
        "runAfter": {
          "Compose_conflict_count": [
            "Succeeded"
          ]
        },
        "else": {
          "actions": {}
        },
        "expression": {
          "greater": [
            "@outputs('Compose_conflict_count')",
            0
          ]
        },
        "type": "If"
      }
    }
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "connectionReferenceLogicalName": "new_sharedsharepointonline_beb06",
      "source": "Embedded",
      "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "displayName": "SharePoint",
