{
  "flowId": "2f2cde97-e0fd-5c5c-934a-02f09a1d83a5",
  "displayName": "D2 - Reschedule Pool",
  "workflowEntityId": "210f1d70-e2ab-f111-aaab-6045bd0196b3",
  "state": "Started",
  "lastModifiedTime": "2026-09-09T00:08:46Z",
  "connectionReferences": {
    "shared_sharepointonline": {
      "connectionName": "shared-sharepointonl-20b83f29-d689-437e-b1ff-930f7bf3fda4",
