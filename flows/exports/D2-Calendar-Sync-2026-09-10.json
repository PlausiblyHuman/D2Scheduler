{
  "flowId": "f890f891-48ad-f111-aaab-6045bd0196b3",
  "displayName": "D2 - Calendar Sync",
  "workflowEntityId": "f890f891-48ad-f111-aaab-6045bd0196b3",
  "state": "Started",
  "lastModifiedTime": "2026-09-10T18:51:46Z",
  "connectionReferences": {
    "shared_office365groups": {
