                "table": "d36758cf-9d27-4342-84e4-817f8dcfa2ba",
                "$filter": "Date eq '@{variables('today')}'",
                "$top": 10
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Compose_2": {
            "runAfter": {
              "Get_items_4": [
                "Succeeded"
              ]
            },
            "metadata": {
              "operationMetadataId": "66e540c2-7b4e-48f2-b4a5-561b38bd1a50"
            },
            "type": "Compose",
            "inputs": "@length(outputs('Get_items_4')?['body/value'])"
          },
          "Condition_2": {
            "actions": {
              "Terminate": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "e8b84bf4-4d4b-415d-97dd-7e52a557ab35"
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            },
            "runAfter": {
              "Compose_2": [
                "Succeeded"
              ]
            },
            "else": {
              "actions": {
                "Apply_to_each": {
                  "foreach": "@outputs('Get_items_3')?['body/value']",
                  "actions": {
                    "Filter_array": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "8f63c53d-a5d6-49e6-9f6b-a7b86459e980"
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Get_items')?['body/value']",
                        "where": "@equals(item()?['Crew']?['Value'], items('Apply_to_each')?['Title'])"
                      }
                    },
                    "Filter_array_2": {
                      "runAfter": {
                        "Filter_array": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "7ddcb2a7-cd9e-43d0-ae2d-1357a8ccec04"
                      },
                      "type": "Query",
                      "inputs": {
                        "from": "@outputs('Get_items_2')?['body/value']",
                        "where": "@equals(item()?['Crew']?['Value'], items('Apply_to_each')?['Title'])"
                      }
                    },
                    "Compose": {
                      "runAfter": {
                        "Filter_array_2": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "61f59d0c-c833-4191-9427-4dad34cdf520"
                      },
                      "type": "Compose",
                      "inputs": "<div style=\"font-family:Segoe UI,sans-serif;font-size:14px;color:#1a2332\"><h2 style=\"color:#0b6e78\">TODAY — @{formatDateTime(variables('today'),'ddd MM/dd')} · @{items('Apply_to_each')?['Title']}</h2>@{if(empty(body('Filter_array')),'<p><em>No sub-phase scheduled today.</em></p>',concat('<p><strong>',first(body('Filter_array'))?['Job']?['Value'],'</strong><br>',first(body('Filter_array'))?['SubPhaseNumber'],' ',first(body('Filter_array'))?['SubPhaseName'],'</p><p><a href=\"https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler/Lists/Assignments/DispForm.aspx?ID=',string(first(body('Filter_array'))?['ID']),'\">Open sub-phase to sign off</a></p>'))}@{if(empty(body('Filter_array_2')),'',concat('<h3 style=\"color:#a84a18\">OUTSTANDING FROM YESTERDAY</h3><p>',string(length(body('Filter_array_2'))),' sub-phase(s) finished yesterday but not yet signed off.</p>'))}</div>"
                    },
                    "Send_an_email_(V2)": {
                      "runAfter": {
                        "Compose": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "5504e828-535c-4747-8602-0c7f8042a448"
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/To": "@items('Apply_to_each')?['LeadEmail']",
                          "emailMessage/Subject": "D2 Dispatch — @{formatDateTime(variables('today'),'ddd MM/dd')} · @{items('Apply_to_each')?['Title']}",
                          "emailMessage/Body": "<p>@{outputs('Compose')}</p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  },
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "fbd75ce0-5711-4cc9-a485-06d7001f4b9b"
                  },
                  "type": "Foreach"
                }
              }
            },
            "expression": {
              "greater": [
                "@outputs('Compose_2')",
