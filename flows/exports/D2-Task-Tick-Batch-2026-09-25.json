   "Has_updates": {
    "actions": {
     "Apply_to_each_update": {
      "foreach": "@json(triggerBody()?['text'])",
      "actions": {
       "Update_task": {
        "runAfter": {},
        "type": "OpenApiConnection",
        "inputs": {
         "parameters": {
          "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
          "parameters/method": "POST",
          "parameters/uri": "_api/web/lists/GetByTitle('Tasks')/items(@{item()?['id']})",
          "parameters/headers": {
           "X-HTTP-Method": "MERGE",
           "If-Match": "*",
           "Content-Type": "application/json;odata=verbose",
           "Accept": "application/json;odata=verbose"
          },
          "parameters/body": "@{string(setProperty(setProperty(setProperty(setProperty(setProperty(json('{\"__metadata\":{\"type\":\"SP.Data.TasksListItem\"}}'), 'Complete', equals(item()?['s'], 'd')), 'NotApplicable', equals(item()?['s'], 'n')), 'CompletedOn', if(equals(item()?['s'], 't'), null, utcNow())), 'CompletedById', if(equals(item()?['s'], 't'), null, body('Ensure_user')?['d']?['Id'])), 'Note', coalesce(item()?['r'], '')))}"
         },
         "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "operationId": "HttpRequest",
          "connectionName": "shared_sharepointonline"
         }
        }
       }
      },
      "runAfter": {},
      "type": "Foreach"
     }
    },
    "runAfter": {
     "Ensure_user": [
      "Succeeded"
     ]
    },
    "else": {
     "actions": {}
    },
    "expression": {
     "and": [
      {
       "not": {
        "equals": [
         "@trim(coalesce(triggerBody()?['text'], ''))",
         ""
        ]
       }
      },
      {
       "not": {
        "equals": [
         "@trim(coalesce(triggerBody()?['text'], ''))",
         "[]"
        ]
       }
      }
     ]
    },
    "type": "If"
   },
   "Update_counters": {
    "runAfter": {
