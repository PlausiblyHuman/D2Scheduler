{
  "properties": {
    "displayName": "D2 - Delete Pool",
    "state": "Started",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "splitOn": "@triggerOutputs()?['body/value']",
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
              "table": "b1ea3db6-7870-4648-80c2-7fe8414ecfd7"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Set_status_deleting": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "HttpRequest",
              "connectionName": "shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "X-HTTP-Method": "MERGE",
                "If-Match": "*",
                "Content-Type": "application/json;odata=verbose",
                "Accept": "application/json;odata=verbose"
              },
              "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Deleting\"}"
            }
          }
        },
        "Condition_missing_fields": {
          "runAfter": {
            "Set_status_deleting": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "or": [
              {
                "equals": [
                  "@empty(trim(coalesce(triggerOutputs()?['body/Title'], '')))",
                  true
                ]
              },
              {
                "equals": [
                  "@empty(trim(coalesce(triggerOutputs()?['body/ConfirmJobNumber'], '')))",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Set_status_refused_blank": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                  "parameters/headers": {
                    "X-HTTP-Method": "MERGE",
                    "If-Match": "*",
                    "Content-Type": "application/json;odata=verbose",
                    "Accept": "application/json;odata=verbose"
                  },
                  "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"Refused: job number and confirmation are both required.\"}"
                }
              }
            },
            "Terminate_refused_blank": {
              "runAfter": {
                "Set_status_refused_blank": [
                  "Succeeded"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Condition_confirm_matches": {
          "runAfter": {
            "Condition_missing_fields": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "not": [
              {
                "equals": [
                  "@trim(coalesce(triggerOutputs()?['body/ConfirmJobNumber'], ''))",
                  "@trim(coalesce(triggerOutputs()?['body/Title'], ''))"
                ]
              }
            ]
          },
          "actions": {
            "Set_status_refused_confirm": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                  "parameters/headers": {
                    "X-HTTP-Method": "MERGE",
                    "If-Match": "*",
                    "Content-Type": "application/json;odata=verbose",
                    "Accept": "application/json;odata=verbose"
                  },
                  "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"Refused: confirmation did not match.\"}"
                }
              }
            },
            "Terminate_refused_confirm": {
              "runAfter": {
                "Set_status_refused_confirm": [
                  "Succeeded"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Init_truncatedAssignmentId": {
          "runAfter": {
            "Condition_confirm_matches": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "truncatedAssignmentId",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Init_taskCount": {
          "runAfter": {
            "Init_truncatedAssignmentId": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "taskCount",
                "type": "integer",
                "value": 0
              }
            ]
          }
        },
        "Scope_preflight": {
          "runAfter": {
            "Init_taskCount": [
              "Succeeded"
            ]
          },
          "type": "Scope",
          "actions": {
            "Get_job": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "table": "ee0ecabf-2f11-458d-a9ea-641f76d10cc3",
                  "$filter": "JobNumber eq '@{trim(triggerOutputs()?['body/Title'])}'",
                  "$top": 1
                }
              }
            },
            "Condition_job_missing": {
              "runAfter": {
                "Get_job": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "equals": [
                  "@length(outputs('Get_job')?['body/value'])",
                  0
                ]
              },
              "actions": {
                "Set_status_refused_missing": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                      "parameters/headers": {
                        "X-HTTP-Method": "MERGE",
                        "If-Match": "*",
                        "Content-Type": "application/json;odata=verbose",
                        "Accept": "application/json;odata=verbose"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"Refused: no job with that number.\"}"
                    }
                  }
                },
                "Terminate_refused_missing": {
                  "runAfter": {
                    "Set_status_refused_missing": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Compose_recipients": {
              "runAfter": {
                "Condition_job_missing": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(and(not(equals(coalesce(triggerOutputs()?['body/Author']?['Email'], ''), '')), not(equals(coalesce(first(outputs('Get_job')?['body/value'])?['ProjectManager']?['Email'], ''), ''))), concat(triggerOutputs()?['body/Author']?['Email'], ';', first(outputs('Get_job')?['body/value'])?['ProjectManager']?['Email']), if(not(equals(coalesce(triggerOutputs()?['body/Author']?['Email'], ''), '')), triggerOutputs()?['body/Author']?['Email'], coalesce(first(outputs('Get_job')?['body/value'])?['ProjectManager']?['Email'], '')))"
            },
            "Get_assignments": {
              "runAfter": {
                "Condition_job_missing": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "table": "49ef7006-d3fe-40a7-a52f-c4c18545bd35",
                  "$filter": "JobId eq @{first(outputs('Get_job')?['body/value'])?['ID']}",
                  "$top": 200
                }
              }
            },
            "Condition_assignments_truncated": {
              "runAfter": {
                "Get_assignments": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "greaterOrEquals": [
                  "@length(outputs('Get_assignments')?['body/value'])",
                  200
                ]
              },
              "actions": {
                "Set_status_refused_truncated_assignments": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                      "parameters/headers": {
                        "X-HTTP-Method": "MERGE",
                        "If-Match": "*",
                        "Content-Type": "application/json;odata=verbose",
                        "Accept": "application/json;odata=verbose"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"Refused: assignment count hit the 200-row read limit, so this pool cannot be safely verified. Escalate.\"}"
                    }
                  }
                },
                "Terminate_refused_truncated_assignments": {
                  "runAfter": {
                    "Set_status_refused_truncated_assignments": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Filter_signed_off": {
              "runAfter": {
                "Condition_assignments_truncated": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Get_assignments')?['body/value']",
                "where": "@equals(item()?['InstallerSignOff'], true)"
              }
            },
            "Condition_signed_off": {
              "runAfter": {
                "Filter_signed_off": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Filter_signed_off'))",
                      0
                    ]
                  },
                  {
                    "equals": [
                      "@not(equals(coalesce(triggerOutputs()?['body/OverrideSignedOff'], false), true))",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Set_status_refused_signedoff": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                      "parameters/headers": {
                        "X-HTTP-Method": "MERGE",
                        "If-Match": "*",
                        "Content-Type": "application/json;odata=verbose",
                        "Accept": "application/json;odata=verbose"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"@{concat('Refused: ', string(length(body('Filter_signed_off'))), ' sub-phase(s) are signed off. Tick Override Signed Off to delete anyway.')}\"}"
                    }
                  }
                },
                "Terminate_refused_signedoff": {
                  "runAfter": {
                    "Set_status_refused_signedoff": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Precheck_task_truncation": {
              "runAfter": {
                "Condition_signed_off": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@outputs('Get_assignments')?['body/value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Get_tasks_precheck": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "table": "22c45847-ff0d-417a-b53e-1ea018fbb6d3",
                      "$filter": "AssignmentId eq @{items('Precheck_task_truncation')?['ID']}",
                      "$top": 200
                    }
                  }
                },
                "Condition_precheck_hit": {
                  "runAfter": {
                    "Get_tasks_precheck": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "greaterOrEquals": [
                      "@length(outputs('Get_tasks_precheck')?['body/value'])",
                      200
                    ]
                  },
                  "actions": {
                    "Set_truncatedAssignmentId": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "truncatedAssignmentId",
                        "value": "@{string(items('Precheck_task_truncation')?['ID'])}"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            },
            "Condition_truncation_found": {
              "runAfter": {
                "Precheck_task_truncation": [
                  "Succeeded"
                ]
              },
              "type": "If",
              "expression": {
                "not": [
                  {
                    "equals": [
                      "@variables('truncatedAssignmentId')",
                      ""
                    ]
                  }
                ]
              },
              "actions": {
                "Set_status_refused_truncated_tasks": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
                      "parameters/headers": {
                        "X-HTTP-Method": "MERGE",
                        "If-Match": "*",
                        "Content-Type": "application/json;odata=verbose",
                        "Accept": "application/json;odata=verbose"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Refused\",\"Result\":\"@{concat('Refused: task count for assignment ', variables('truncatedAssignmentId'), ' hit the 200-row read limit, so this pool cannot be safely verified. Escalate.')}\"}"
                    }
                  }
                },
                "Terminate_refused_truncated_tasks": {
                  "runAfter": {
                    "Set_status_refused_truncated_tasks": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        },
        "Compose_preflight_failure_message": {
          "runAfter": {
            "Scope_preflight": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Compose",
          "inputs": "@concat('Failed: a pre-check step failed or timed out while preparing to delete ', triggerOutputs()?['body/Title'], '. Deletion DID NOT START. No tasks, assignments, or the job itself were touched. Escalate for investigation, then resubmit once the underlying issue (e.g. SharePoint throttling) is resolved.')"
        },
        "Set_status_failed_preflight": {
          "runAfter": {
            "Compose_preflight_failure_message": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "HttpRequest",
              "connectionName": "shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/GetByTitle('Delete Pool Requests')/items(@{triggerOutputs()?['body/ID']})",
              "parameters/headers": {
                "X-HTTP-Method": "MERGE",
                "If-Match": "*",
                "Content-Type": "application/json;odata=verbose",
                "Accept": "application/json;odata=verbose"
              },
              "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.Delete_x0020_Pool_x0020_RequestsListItem\"},\"Status\":\"Failed\",\"Result\":\"@{outputs('Compose_preflight_failure_message')}\"}"
            }
          }
        },
        "Send_preflight_failure_email": {
          "runAfter": {
            "Set_status_failed_preflight": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@{coalesce(triggerOutputs()?['body/Author']?['Email'], '')}",
              "emailMessage/Subject": "URGENT: Pool deletion could not start: @{triggerOutputs()?['body/Title']}",
              "emailMessage/Body": "<p>@{outputs('Compose_preflight_failure_message')}</p>",
              "emailMessage/Importance": "High"
            }
          }
        },
        "Terminate_failed_preflight": {
          "runAfter": {
            "Send_preflight_failure_email": [
              "Succeeded"
            ]
          },
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed"
          }
        },
        "Apply_to_each_assignment": {
          "runAfter": {
            "Scope_preflight": [
              "Succeeded"
            ]
          },
          "type": "Foreach",
          "foreach": "@outputs('Get_assignments')?['body/value']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Get_tasks_for_assignment": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "table": "22c45847-ff0d-417a-b53e-1ea018fbb6d3",
                  "$filter": "AssignmentId eq @{items('Apply_to_each_assignment')?['ID']}",
                  "$top": 200
                }
              }
            },
            "Increment_taskCount": {
              "runAfter": {
                "Get_tasks_for_assignment": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "taskCount",
                "value": "@length(outputs('Get_tasks_for_assignment')?['body/value'])"
              }
            },
            "Apply_to_each_task": {
              "runAfter": {
                "Increment_taskCount": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@outputs('Get_tasks_for_assignment')?['body/value']",
              "actions": {
                "Delete_task": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "connectionName": "shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                      "parameters/method": "DELETE",
                      "parameters/uri": "_api/web/lists/GetByTitle('Tasks')/items(@{items('Apply_to_each_task')?['ID']})",
                      "parameters/headers": {
                        "If-Match": "*"
                      }
                    }
                  }
                }
              }
            },
            "Delete_assignment": {
              "runAfter": {
                "Apply_to_each_task": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "connectionName": "shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
                  "parameters/method": "DELETE",
                  "parameters/uri": "_api/web/lists/GetByTitle('Assignments')/items(@{items('Apply_to_each_assignment')?['ID']})",
                  "parameters/headers": {
                    "If-Match": "*"
                  }
                }
              }
            }
          }
        },
        "Delete_job": {
          "runAfter": {
            "Apply_to_each_assignment": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "HttpRequest",
              "connectionName": "shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://netorgft15040037.sharepoint.com/sites/D2BuildScheduler",
              "parameters/method": "DELETE",
