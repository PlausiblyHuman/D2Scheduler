[
 {
  "label": "every finding its own group",
  "find": "const key=kind==='double'?'double|'+x.crewId:(kind==='unassigned'||kind==='shared'||!x.jobId)?kind:kind+'|'+x.jobId;",
  "replace": "const key=kind+'|'+x.jobId+'|'+(x.pos?x.pos.gi+'.'+x.pos.si:'')+'|'+(x.day||'');"
 },
 {
  "label": "Unassigned grouped per project",
  "find": "(kind==='unassigned'||kind==='shared'||!x.jobId)?kind:",
  "replace": "(kind==='shared'||!x.jobId)?kind:"
 },
 {
  "label": "root is the last finding, not the first",
  "find": "groups.forEach(g=>{g.root=g.items[0];",
  "replace": "groups.forEach(g=>{g.root=g.items[g.items.length-1];"
 },
 {
  "label": "groups not sorted",
  "find": "return groups.sort((a,b)=>(a.lvl==='err'?0:1)-(b.lvl==='err'?0:1)||b.items.length-a.items.length);",
  "replace": "return groups;"
 },
 {
  "label": "larger groups not first",
  "find": "(a.lvl==='err'?0:1)-(b.lvl==='err'?0:1)||b.items.length-a.items.length",
  "replace": "(a.lvl==='err'?0:1)-(b.lvl==='err'?0:1)||a.items.length-b.items.length"
 },
 {
