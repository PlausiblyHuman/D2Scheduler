 {
  "label": "rating sort removed",
  "find": "(rt(b)-rt(a))||((load[a.id]||0)-(load[b.id]||0))||a.id.localeCompare(b.id))){",
  "replace": "((load[a.id]||0)-(load[b.id]||0))||a.id.localeCompare(b.id))){"
 },
