[
 {
  "label": "controls rendered on locked and signed rows too",
  "find": "function inlineEditable(j,s){ return !frozen(j) && !s.skip && !s.locked && !s.inst; }",
  "replace": "function inlineEditable(j,s){ return !frozen(j) && !s.skip; }"
 },
 {
  "label": "controls rendered on a building project",
  "find": "function inlineEditable(j,s){ return !frozen(j) && !s.skip && !s.locked && !s.inst; }",
  "replace": "function inlineEditable(j,s){ return !s.skip && !s.locked && !s.inst; }"
 },
 {
  "label": "crew change not recorded",
  "find": "s.crewId=v||null; touch(j); save(); render(); return; }",
  "replace": "render(); return; }"
 },
 {
  "label": "crew change reflows the project",
  "find": "s.crewId=v||null; touch(j); save(); render(); return; }",
  "replace": "s.crewId=v||null; touch(j); reflowFrom(jobId,gi,si); s.start=nextWork(addCal(s.start,1)); save(); render(); return; }"
 },
 {
  "label": "days change does not reflow",
  "find": "  if(s.start)reflowFrom(jobId,gi,si);\n  save(); render();\n}",
  "replace": "  save(); render();\n}"
 },
 {
  "label": "start not snapped to a working day",
  "find": "else if(k==='start') s.start=v?nextWork(v):null;",
  "replace": "else if(k==='start') s.start=v||null;"
 },
 {
  "label": "days below one accepted",
  "find": "if(k==='days') s.days=Math.max(1,+v||1);",
  "replace": "if(k==='days') s.days=+v;"
 },
 {
  "label": "inline edit not marked as edited",
  "find": "  else return;\n  touch(j);\n  if(s.start)reflowFrom(jobId,gi,si);",
  "replace": "  else return;\n  if(s.start)reflowFrom(jobId,gi,si);"
 },
 {
  "label": "crew names unescaped in the dropdown",
  "find": "${esc(c.name)}${suffix}</option>`;",
  "replace": "${c.name}${suffix}</option>`;"
 },
 {
  "label": "Not qualified crews offered as qualified",
  "find": "const ready=cands.filter(c=>assignable(c)), other=S.crews.filter(c=>!ready.includes(c));",
  "replace": "const ready=S.crews.slice(), other=[];"
 },
 {
  "label": "controls placed inside the clickable name",
  "find": "onclick=\"editSec('${j.id}',${gi},${si})\"><b>${s.num}</b> ${s.name}",
  "replace": "onclick=\"editSec('${j.id}',${gi},${si})\"><b>${s.num}</b> ${s.name}${inlineEditable(j,s)?inlineControls(j,gi,si,s,fin):''}"
 },
 {
  "label": "Save sends no finish with a start or days change",
  "find": ",\n    finishFor:(st,d)=>workSpan(st,d).pop()});",
  "replace": "});"
 },
 {
  "label": "every row drawn with live controls",
  "find": "  if(!live){\n    const c=s.crewId",
  "replace": "  if(false){\n    const c=s.crewId"
 },
 {
  "label": "opening a row redraws the whole Board",
  "find": "  box.innerHTML=inlineControls(j,gi,si,s,fin,true);",
  "replace": "  render();"
 },
 {
  "label": "the opened control is not focused",
  "find": "  c.focus();\n",
  "replace": "\n"
 },
 {
  "label": "closed crew label unescaped",
  "find": "${esc(c?c.name:'— Unassigned —')}</button>",
  "replace": "${c?c.name:'— Unassigned —'}</button>"
 },
 {
  "label": "Board timeline spans every project",
  "find": "const shown=boardJobs(true), ax=axis(shown);",
  "replace": "const shown=boardJobs(true), ax=axis();"
 },
 {
  "label": "pseudo-trade label unescaped",
  "find": "if(FIXED[id]){const c=fixedCrew(id);return esc(c?c.name:id);}",
  "replace": "if(FIXED[id]){const c=fixedCrew(id);return c?c.name:id;}"
 }
]